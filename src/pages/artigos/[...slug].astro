---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ data }) => !data.draft
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
}).format(post.data.pubDate);
---

<BaseLayout
  title={`${post.data.title} | Meu Blog`}
  description={post.data.description}
  image={post.data.cover}
>
  <article class="container article">
    <a href="/" class="back">← Voltar para o início</a>

    <header class="article-header">
      <span class="category">{post.data.category}</span>

      <h1>{post.data.title}</h1>

      <p>{post.data.description}</p>

      <time datetime={post.data.pubDate.toISOString()}>
        Publicado em {date}
      </time>
    </header>

    {post.data.cover && (
      <img
        class="cover"
        src={post.data.cover}
        alt={post.data.title}
      />
    )}

    <div class="prose">
      <Content />
    </div>

    <div class="article-footer">
      <a href="/">← Todos os artigos</a>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: 45px;
  }

  .back {
    font-size: 13px;
    color: var(--muted);
  }

  .article-header {
    padding: 55px 0 35px;
  }

  .category {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .article-header h1 {
    font-size: clamp(36px, 7vw, 55px);
    line-height: 1.12;
    letter-spacing: -2px;
    margin: 15px 0;
  }

  .article-header p,
  .article-header time {
    color: var(--muted);
  }

  .article-header time {
    font-size: 13px;
  }

  .cover {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 35px;
  }

  .prose {
    font-size: 17px;
    line-height: 1.9;
  }

  .prose h2,
  .prose h3 {
    margin-top: 40px;
    line-height: 1.3;
    letter-spacing: -1px;
  }

  .prose p {
    margin: 22px 0;
  }

  .prose a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .prose blockquote {
    border-left: 3px solid var(--border);
    padding-left: 20px;
    color: var(--muted);
  }

  .prose pre {
    overflow-x: auto;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .prose code {
    font-size: .9em;
  }

  .article-footer {
    border-top: 1px solid var(--border);
    padding: 30px 0;
    margin-top: 50px;
    font-weight: 700;
  }
</style>