---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página não encontrada | Meu Blog"
  description="A página que você procura não existe."
>
  <section class="container error">
    <span>404</span>
    <h1>Esta página não existe.</h1>
    <p>Talvez o conteúdo tenha sido removido ou o endereço esteja incorreto.</p>
    <a href="/">Voltar para o início →</a>
  </section>
</BaseLayout>

<style>
  .error {
    padding-top: 110px;
    padding-bottom: 100px;
    text-align: center;
  }

  .error span {
    font-size: 70px;
    font-weight: 800;
    color: var(--muted);
  }

  .error h1 {
    font-size: 32px;
  }

  .error p {
    color: var(--muted);
  }

  .error a {
    display: inline-block;
    margin-top: 20px;
    font-weight: bold;
  }
</style>